---
import { getCollection } from "astro:content";
import { ArrowRight, BrainCircuit, CodeXml, Layers3, Sparkles } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const posts = (await getCollection("posts", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = posts.filter((post) => post.data.featured).slice(0, 3);
const knowledgeEngineUrl = `${base}/knowledge-engine/index.html`;
const qimuHomeUrl = `${base}/qimu-home/`;
const pawformUrl = `${base}/pawform/`;
const aurenObjectsUrl = `${base}/auren-objects/`;
const novaTurnUrl = `${base}/nova-turn/`;
const nourishFreshUrl = `${base}/nourish-fresh/`;
const aquamarineTriptychUrl = `${base}/aquamarine-triptych/`;
const oneDropLandscapeUrl = `${base}/one-drop-landscape/`;
const guanshanUrl = `${base}/guanshan/`;
const baguaUrl = `${base}/bagua/`;
const sonoraUrl = `${base}/sonora-s1/v2.html`;
const codexRepoUrl = "https://github.com/EdithJenius/Codex_f";
const sonoraSourceUrl = `${codexRepoUrl}/tree/main/ChatGPT/sonora-3d`;
const davinciUrl = `${codexRepoUrl}/tree/main/%E8%A7%86%E9%A2%91%E6%B5%81/DaVinci-AutoEdit-Agent`;
const douyinMcpUrl = `${codexRepoUrl}/tree/main/xhs_mcpdev/cmd/douyin-mcp`;
const webupUrl = "https://github.com/EdithJenius/webup-agent-team-control-plane";
const webProjects = [
  {
    title: "应县木塔 · 木构的时间",
    category: "3D 数字博物馆实验",
    description: "从整塔环绕、斗拱特写到分层展开与复原，探索木构建筑的结构。模型为科普示意，非测绘成果。",
    href: `${base}/yingxian-museum/`,
    image: `${base}/images/web-portfolio/yingxian-museum.jpg`,
    alt: "应县木塔三维数字展厅",
    featured: true,
  },
  {
    title: "ROTOR LAB",
    category: "旋翼机构教学实验 · 第二版",
    description: "可旋转观察、分解与播放动画的机构实验台。外观仍待验收，不用于制造、维修或飞行安全判断。",
    href: `${base}/rotor-lab/web/`,
    image: `${base}/images/web-portfolio/rotor-lab.jpg`,
    alt: "ROTOR LAB 旋翼机构三维教学实验台",
    featured: false,
  },
  {
    title: "Sonora S1",
    category: "3D 概念产品体验站",
    description: "以可拆解音箱、滚动叙事与配色切换，探索声音、材料与空间的关系。",
    href: sonoraUrl,
    image: `${base}/images/web-portfolio/sonora-s1.jpg`,
    alt: "Sonora S1 模块化音箱的 3D 产品体验首屏",
    featured: true,
  },
  {
    title: "栖木家居 QIMU HOME",
    category: "家居品牌合作站",
    description: "以实木家具为原点，呈现产品场景、材质工艺与城市合作路径。",
    href: qimuHomeUrl,
    image: `${base}/images/web-portfolio/qimu-home.jpg`,
    alt: "栖木家居网站首页，深色文字区与家居空间场景并列",
    featured: false,
  },
  {
    title: "PAWFORM",
    category: "宠物生活品牌站",
    description: "连接营养、居家与户外日常的宠物品牌体验。",
    href: pawformUrl,
    image: `${base}/images/web-portfolio/pawform.jpg`,
    alt: "PAWFORM 网站首页，金毛犬与宠物生活用品陈列",
    featured: false,
  },
  {
    title: "AUREN OBJECTS",
    category: "珠宝零售体验站",
    description: "以光影探索首饰系列，并串联商品、收藏与购物袋交互。",
    href: aurenObjectsUrl,
    image: `${base}/images/web-portfolio/auren-objects.jpg`,
    alt: "AUREN OBJECTS 网站首页，蓝色宝石戒指置于深色矿石背景",
    featured: false,
  },
  {
    title: "NOVA TURN",
    category: "工业设备销售站",
    description: "面向中文市场的数控车床官网，强调产品能力与询价转化。",
    href: novaTurnUrl,
    image: `${base}/images/web-portfolio/nova-turn.jpg`,
    alt: "NOVA TURN 网站首页，数控加工场景与中文产品标题",
    featured: false,
  },
  {
    title: "Nourish Fresh",
    category: "宠物鲜食体验站",
    description: "围绕鲜食配方、原料与冷链故事构建沉浸式产品体验。",
    href: nourishFreshUrl,
    image: `${base}/images/web-portfolio/nourish-fresh.jpg`,
    alt: "Nourish Fresh 网站首页，宠物影像与鲜食产品组成画面",
    featured: false,
  },
  {
    title: "Aquamarine Triptych",
    category: "海蓝宝叙事体验站",
    description: "以海洋、星空与冰川三重章节，展开海蓝宝首饰的电影化叙事体验。",
    href: aquamarineTriptychUrl,
    image: `${base}/images/web-portfolio/aquamarine-triptych.jpg`,
    alt: "Aquamarine Triptych 海蓝宝首饰叙事网站首页",
    featured: false,
  },
  {
    title: "一滴山河",
    category: "水晶手串体验站",
    description: "从山水意象进入材质、光线与佩戴细节，形成可探索的水晶商品档案。",
    href: oneDropLandscapeUrl,
    image: `${base}/images/web-portfolio/one-drop-landscape.jpg`,
    alt: "一滴山河水晶手串网站首页",
    featured: false,
  },
  {
    title: "观山五行",
    category: "五行水晶产品站",
    description: "围绕水、木、土、火、金五组产品，组合沉浸式首屏、选品与购物交互。",
    href: guanshanUrl,
    image: `${base}/images/web-portfolio/guanshan.jpg`,
    alt: "观山五行水晶产品网站首页",
    featured: false,
  },
  {
    title: "玄枢 · 八卦六爻",
    category: "3D 传统文化互动站",
    description: "以九层实体阵盘、蓄力唤醒与六次起卦组成可交互的 Three.js 文化体验。",
    href: baguaUrl,
    image: `${base}/images/web-portfolio/bagua-3d.jpg`,
    alt: "玄枢 3D 八卦六爻网站的九层立体阵盘",
    featured: false,
  },
];
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">AI PRODUCT · AGENT · PRACTICE</p>
        <h1>在复杂问题里，<br />做清晰、有用的产品。</h1>
        <p class="hero-intro">
          我是 Edith，关注 AI 产品、Agent 系统与知识工作流。
          这里记录我的项目实践、方法思考，以及那些真正落地之后才会遇到的问题。
        </p>
        <div class="hero-actions">
          <a class="primary-action" href={`${base}/posts/`}>阅读文章 <ArrowRight size={17} /></a>
          <a class="secondary-action" href={`${base}/projects/`}>查看项目</a>
        </div>
        <div class="proof-row" aria-label="内容概览">
          <span><strong>3</strong> 个实践方向</span>
          <span><strong>18</strong> 个项目入口</span>
          <span><strong>持续</strong> 更新笔记</span>
        </div>
      </div>
      <div class="hero-visual" aria-label="工作主题">
        <div class="visual-heading">
          <span>FIELD NOTES</span>
          <span>2026</span>
        </div>
        <div class="visual-center">
          <Sparkles size={28} stroke-width={1.5} />
          <strong>Ideas<br />into<br />systems.</strong>
        </div>
        <div class="visual-footer">
          <span>产品判断</span><span>系统设计</span><span>持续交付</span>
        </div>
      </div>
    </div>
  </section>

  <section class="topic-strip">
    <div class="shell topic-inner">
      <p>知识主题</p>
      <div>
        <a href={`${base}/posts/`}>AI 产品</a>
        <a href={`${base}/posts/`}>Agent 系统</a>
        <a href={`${base}/posts/`}>知识工作流</a>
        <a href={`${base}/projects/`}>项目复盘</a>
      </div>
    </div>
  </section>

  <section class="web-portfolio" id="web-portfolio">
    <div class="shell">
      <div class="portfolio-heading">
        <p class="eyebrow">WEB PORTFOLIO</p>
        <h2 class="section-title">网页作品集</h2>
        <p class="section-lead">从消费品牌、工业设备到 3D 文化与概念产品体验，十个独立网站均已部署为可直接访问的 GitHub Pages 静态站。</p>
      </div>
      <div class="portfolio-grid">
        {webProjects.map((project) => (
          <a class:list={["portfolio-item", { featured: project.featured }]} href={project.href}>
            <figure class="portfolio-media">
              <img
                src={project.image}
                alt={project.alt}
                loading={project.featured ? "eager" : "lazy"}
                width="1440"
                height="960"
              />
            </figure>
            <div class="portfolio-copy">
              <div>
                <p>{project.category}</p>
                <h3>{project.title}</h3>
              </div>
              <p class="portfolio-description">{project.description}</p>
              <span>打开网站 <ArrowRight size={16} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="focus">
    <div class="shell">
      <div class="focus-heading">
        <div>
          <p class="eyebrow">CURRENT FOCUS</p>
          <h2 class="section-title">正在研究与实践</h2>
        </div>
        <p class="section-lead">我更关心 AI 如何进入真实工作，而不只是展示能力。以下是目前持续投入的三个方向。</p>
      </div>
      <div class="focus-grid">
        <article>
          <span class="focus-number">01</span>
          <h3>AI 产品化</h3>
          <p>从业务问题、用户流程到评估指标，把模型能力转化为可反复使用的产品。</p>
        </article>
        <article>
          <span class="focus-number">02</span>
          <h3>Agent 系统</h3>
          <p>探索多 Agent 协作、上下文管理、工具调用，以及长期任务中的可靠交付。</p>
        </article>
        <article>
          <span class="focus-number">03</span>
          <h3>知识工作流</h3>
          <p>让知识库不再只是资料集合，而是能支持判断、执行、复盘与持续迭代的系统。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="engine-panel" id="knowledge-engine">
    <div class="shell engine-grid">
      <div>
        <p class="eyebrow">KNOWLEDGE ENGINE</p>
        <h2 class="section-title">知识迭代引擎网页端</h2>
        <p class="section-lead">
          一个用于查看学习主线、实验进度、评测结果、Codex 反馈和能力进展的操作台。
          后台知识收集与写入交给 Codex，网页端负责把当前状态清楚地呈现出来。
        </p>
        <a class="engine-link" href={knowledgeEngineUrl}>
          打开网页端 <ArrowRight size={17} />
        </a>
      </div>
      <a class="engine-preview" href={knowledgeEngineUrl} aria-label="打开知识迭代引擎网页端">
        <div class="engine-preview-head">
          <span><BrainCircuit size={18} /> Learning View</span>
          <strong>LIVE</strong>
        </div>
        <div class="engine-preview-body">
          <div>
            <span>实验进度</span>
            <strong>72%</strong>
          </div>
          <div>
            <span>评测通过</span>
            <strong>8/10</strong>
          </div>
          <div>
            <span>反馈记录</span>
            <strong>24</strong>
          </div>
        </div>
      </a>
    </div>
  </section>

  <section class="lab-updates" id="mini-program-data-merge">
    <div class="shell">
      <div class="section-row">
        <div>
          <p class="eyebrow">UPDATE LOG</p>
          <h2 class="section-title">小程序开发与数据合并实验</h2>
        </div>
        <a class="text-link" href="https://github.com/EdithJenius/Codex_f" target="_blank" rel="noreferrer">
          查看代码 <ArrowRight size={16} />
        </a>
      </div>
      <div class="update-grid">
        <article>
          <span class="update-index">01</span>
          <h3>微信小程序业务前端</h3>
          <p>
            基于 vt-weixin01 梳理酒店、优惠券、权益、用户与门店接口，沉淀小程序端请求封装、
            状态管理、Vant Weapp 组件集成和地图能力接入。
          </p>
        </article>
        <article>
          <span class="update-index">02</span>
          <h3>酒店房型动态适配</h3>
          <p>
            围绕游虾鲸酒店数据接入，设计酒店映射表、房型价格动态查询、早餐与取消规则适配，
            尽量保持现有小程序接口稳定。
          </p>
        </article>
        <article>
          <span class="update-index">03</span>
          <h3>多源数据合并</h3>
          <p>
            将供应商侧 whaleHotelId、whaleRoomId、ratePlanId、detailId 等关键标识保留下来，
            为后续多供应商房型合并、标准化展示和可下单链路预留空间。
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="current-builds" id="current-builds">
    <div class="shell builds-grid">
      <div>
        <p class="eyebrow">CURRENT BUILDS</p>
        <h2 class="section-title">近期项目更新</h2>
        <p class="section-lead">
          从 3D 产品体验、自动剪辑到多角色网站交付和内容研究工具，
          记录近期项目进展、可体验的实验与各自的使用边界。
        </p>
      </div>
      <div class="build-list">
        <article>
          <span>NEW</span>
          <h3><a href={`${base}/yingxian-museum/`}>应县木塔数字博物馆</a></h3>
          <p>Blender 建模与 Three.js 实时展示，支持六章滚动叙事、结构展开和重新聚合；模型仅用于科普展示。</p>
        </article>
        <article>
          <span>NEW</span>
          <h3><a href={`${base}/rotor-lab/web/`}>ROTOR LAB 旋翼实验台</a></h3>
          <p>第二版提供部件观察、实时控制与 11 段 GLB 动画。当前是视觉与运动教学近似，外观仍待验收。</p>
        </article>
        <article>
          <span>01</span>
          <h3><a href={sonoraUrl}>Sonora S1 3D 音箱</a></h3>
          <p>用 Three.js 完成模块化音箱的拆解、运动、配色与滚动叙事，并适配 GitHub Pages 子路径部署。<a href={sonoraSourceUrl} target="_blank" rel="noreferrer">查看源码</a>。</p>
        </article>
        <article>
          <span>02</span>
          <h3><a href={davinciUrl} target="_blank" rel="noreferrer">DaVinci AutoEdit Agent</a></h3>
          <p>新增自适应抽帧、FFmpeg 音频证据、剪辑蓝图校验与 Resolve 能力路由，让无 Resolve 时的预览路径也能清晰运行。</p>
        </article>
        <article>
          <span>03</span>
          <h3><a href={webupUrl} target="_blank" rel="noreferrer">Webup Agent Team Control Plane</a></h3>
          <p>为多角色网站交付建立可审计的任务、租约、审批、素材权利和发布控制，并以独立公开仓库维护可复用实现。</p>
        </article>
        <article>
          <span>04</span>
          <h3><a href={baguaUrl}>玄枢 · 3D 八卦六爻</a></h3>
          <p>九层实体阵盘继续补强多轴翻转、极向布局、古籍纹理与高分辨率铭文，同步覆盖桌面、平板和手机测试。</p>
        </article>
        <article>
          <span>05</span>
          <h3><a href={douyinMcpUrl} target="_blank" rel="noreferrer">抖音评论只读 MCP</a></h3>
          <p>完成评论分页读取与连续游标传递，方便在不执行发布或互动的前提下进行内容研究。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="latest">
    <div class="shell">
      <div class="section-row">
        <div>
          <p class="eyebrow">LATEST WRITING</p>
          <h2 class="section-title">近期文章</h2>
        </div>
        <a class="text-link" href={`${base}/posts/`}>查看全部 <ArrowRight size={16} /></a>
      </div>
      <div class="post-grid">
        {featured.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="project-band">
    <div class="shell project-inner">
      <div class="project-icon"><Layers3 size={26} /></div>
      <div>
        <p class="eyebrow">SELECTED WORK</p>
        <h2>把探索做成可以使用的东西。</h2>
        <p>从 ERP 工具、课程体系到内容与知识工作流，我在项目里验证想法，也在交付里修正判断。</p>
      </div>
      <a href={`${base}/projects/`}>项目档案 <ArrowRight size={17} /></a>
    </div>
  </section>

  <section class="connect">
    <div class="shell connect-inner">
      <div>
        <p class="eyebrow">CONNECT</p>
        <h2 class="section-title">保持交流，也保持好奇。</h2>
      </div>
      <a href="https://github.com/EdithJenius" target="_blank" rel="noreferrer">
        <CodeXml size={20} /> GitHub
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero { padding: 76px 0 68px; border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(320px, .65fr); gap: 80px; align-items: stretch; }
  .hero-copy { padding: 32px 0 28px; }
  h1 { max-width: 760px; margin: 0; font-family: Georgia, "Noto Serif SC", serif; font-size: clamp(48px, 7vw, 82px); font-weight: 500; line-height: 1.08; }
  .hero-intro { max-width: 650px; margin: 32px 0 0; color: var(--muted); font-size: 17px; line-height: 1.9; }
  .hero-actions { display: flex; align-items: center; gap: 22px; margin-top: 38px; }
  .primary-action, .secondary-action { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; font-size: 14px; font-weight: 750; }
  .primary-action { gap: 8px; padding: 0 20px; color: white; background: var(--ink); }
  .primary-action:hover { background: var(--accent); }
  .secondary-action { border-bottom: 1px solid var(--ink); }
  .proof-row { display: flex; flex-wrap: wrap; gap: 22px; margin-top: 46px; color: var(--muted); font-size: 12px; }
  .proof-row span { display: inline-flex; align-items: baseline; gap: 5px; }
  .proof-row strong { color: var(--ink); font-family: Georgia, serif; font-size: 16px; font-weight: 500; }
  .hero-visual { display: flex; min-height: 430px; padding: 24px; color: #f6f2e9; background: var(--green); flex-direction: column; justify-content: space-between; }
  .visual-heading, .visual-footer { display: flex; align-items: center; justify-content: space-between; font-size: 11px; font-weight: 700; }
  .visual-center { display: flex; align-items: flex-start; gap: 20px; }
  .visual-center strong { font-family: Georgia, serif; font-size: 50px; font-weight: 500; line-height: .92; }
  .visual-footer { border-top: 1px solid rgba(255,255,255,.28); padding-top: 17px; }
  .topic-strip { border-bottom: 1px solid var(--line); background: var(--surface); }
  .topic-inner { display: flex; min-height: 76px; align-items: center; justify-content: space-between; }
  .topic-inner p { margin: 0; color: var(--muted); font-size: 12px; font-weight: 750; }
  .topic-inner div { display: flex; flex-wrap: wrap; gap: 30px; }
  .topic-inner a { font-family: Georgia, "Noto Serif SC", serif; font-size: 15px; }
  .topic-inner a:hover { color: var(--accent); }
  .web-portfolio { padding: 92px 0 96px; border-bottom: 1px solid var(--line); background: #fffdf8; }
  .portfolio-heading { max-width: 720px; }
  .portfolio-heading .section-lead { margin-top: 22px; }
  .portfolio-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 58px 28px; margin-top: 50px; }
  .portfolio-item { display: block; min-width: 0; color: inherit; }
  .portfolio-item.featured { grid-column: 1 / -1; }
  .portfolio-media { overflow: hidden; aspect-ratio: 3 / 2; margin: 0; border: 1px solid var(--line); background: #e8e7e2; }
